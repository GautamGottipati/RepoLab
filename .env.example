# Copy to `.env` and fill in your own values.
#
# This file is a template and is meant to be shared: it must never contain a
# real credential. `.env` is gitignored and is where real values belong.
#
# ---------------------------------------------------------------------------
# Nebius Token Factory
# ---------------------------------------------------------------------------
# Used for BOTH Nemotron inference and Sandboxes (ConTree).
NEBIUS_API_KEY=your-nebius-token-factory-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Sandboxes (ConTree) additionally require a project ID, sent as a `Project`
# header alongside the bearer token. Inference does not need it.
NEBIUS_PROJECT_ID=aiproject-your-project-id

# ---------------------------------------------------------------------------
# Nemotron model routing
# ---------------------------------------------------------------------------
# Model IDs are NEVER hardcoded in application code -- they are read from here.
#
# The candidates below were observed in Nebius documentation during Phase 0 but
# are UNVERIFIED: casing is inconsistent across Nebius sources and the catalog
# changes. Run `make check` to validate whatever you set here against the live
# /v1/models catalog before relying on it.
#
#   candidate nano:  nvidia/nvidia-nemotron-3-nano-30b-a3b
#   candidate super: nvidia/nemotron-3-super-120b-a12b
#   candidate ultra: nvidia/Nemotron-3-Ultra-550b-a55b
#   candidate extra: nvidia/Nemotron-3_5-Lightning
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional. Per-model prices in USD per 1M tokens, keyed by model ID. Used only
# to estimate call cost; when a model is absent here, cost is reported as
# unknown rather than guessed.
#   MODEL_PRICING={"nvidia/some-model":{"input":0.05,"output":0.20}}
MODEL_PRICING=

# Hard timeout for a single model call, in seconds.
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Tavily research
# ---------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-api-key

# ---------------------------------------------------------------------------
# Local infrastructure (docker compose up)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://repolab:repolab@localhost:5432/repolab
REDIS_URL=redis://localhost:6379/0
